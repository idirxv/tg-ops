# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME

# Base URL where the bot can reach Dockhand
DOCKHAND_URL=http://dockhand:3000

# Dockhand API token (Settings -> API tokens), starts with dh_
DOCKHAND_API_TOKEN=dh_REPLACE_ME

# Comma-separated Telegram chat IDs allowed to use the bot
ALLOWED_CHAT_IDS=123456789

# Comma-separated stack names the bot may control.
# Do NOT include the bot's own stack.
ALLOWED_STACKS=media,vpn,monitoring

# Numeric Dockhand environment id (GET /api/environments -> "id").
# Required: without it Dockhand returns an empty stack list.
DOCKHAND_ENV=1

# Optional: DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO

# --- Webhook mode (optional; default is polling) ---
# BOT_MODE=webhook enables push delivery via Cloudflare Tunnel
#BOT_MODE=polling
# Full public URL incl. path, must be https
#WEBHOOK_URL=https://tgbot.example.com/telegram
# Generate with: openssl rand -hex 32
#WEBHOOK_SECRET=
#WEBHOOK_PORT=5555
